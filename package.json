{
  "name": "audiomass",
  "version": "2.0.0",
  "description": "Free full-featured web-based audio & waveform editing tool with in-browser AI transcription and summarization",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,css}\" \"public/workers/*.js\" \"*.{js,json,md,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"public/workers/*.js\" \"*.{js,json,md,html}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "vite": "^7.0.0"
  }
}
